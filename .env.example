# ============================================================================
#  Presupuesto — variables de entorno
#  Copia este archivo a .env.local y rellena los valores.
#  .env.local está en .gitignore: nunca subas secretos al repo.
# ============================================================================

# ---------------------------------------------------------------------------
#  Supabase  →  Project Settings → API
# ---------------------------------------------------------------------------

# URL del proyecto, p. ej. https://abcdefghijk.supabase.co
# Lleva prefijo NEXT_PUBLIC_ por convención de Supabase; no es un secreto.
NEXT_PUBLIC_SUPABASE_URL=

# service_role key. SECRETO. Bypassea Row Level Security.
# Solo se usa en el servidor (Route Handlers y Server Components).
# Nunca la pongas en una variable NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
#  Ingesta desde Google Apps Script
# ---------------------------------------------------------------------------

# Clave compartida que Apps Script envía en la cabecera `x-ingest-key`.
# SECRETO. Genera una larga y aleatoria, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GMAIL_INGEST_KEY=

# ---------------------------------------------------------------------------
#  Acceso a la aplicacion (PIN de 4 digitos)  --  OBLIGATORIAS
# ---------------------------------------------------------------------------

# Hash del PIN. SECRETO, aunque no sea reversible: con 4 digitos son 10 000
# combinaciones y quien lo tenga lo rompe en segundos. El PIN en si NO se guarda
# en ninguna parte.
#
# Generalo con:   npm run auth:hash
# (pide el PIN por teclado sin mostrarlo; no lo pases por argumento, quedaria en
#  el historial de la terminal)
#
# Formato: scrypt.16384.8.1.<sal>.<hash>
# Solo letras, numeros, punto, guion y guion bajo: los `$` los expandiria Next
# al leer este archivo y el hash llegaria roto.
AUTH_PIN_HASH=

# Clave con la que se firma la cookie de sesion. SECRETO. Minimo 32 caracteres.
# Cambiarla cierra la sesion en todos los dispositivos: es la unica forma de
# revocar sesiones, porque la cookie es autocontenida y no hay tabla que borrar.
#
# Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# ---------------------------------------------------------------------------
#  Sugerencia de categoria con Gemini  (OPCIONAL)
# ---------------------------------------------------------------------------

# Sin esta clave la sugerencia SIGUE FUNCIONANDO: usa solo el historial de tus
# propios movimientos y nunca sale a internet. Gemini es el segundo intento,
# para cuando el historial no alcanza.
#
# SECRETO. Solo servidor: no lleva prefijo NEXT_PUBLIC_ y nunca se envia al
# navegador.
#
# Donde sacarla: https://aistudio.google.com/apikey -> Create API key
GEMINI_API_KEY=

# Modelo a usar. El barato basta de sobra para clasificar un nombre de comercio.
# Por defecto gemini-3.5-flash-lite: el 2.5 ya no se sirve a claves nuevas.
# GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
#  Tipo de cambio USD -> PEN  (opcional)
# ---------------------------------------------------------------------------

# La aplicacion funciona SIN configurar nada aqui: usa por defecto la API
# publica de SUNAT (api.apis.net.pe), que no necesita clave y devuelve el tipo
# de cambio oficial peruano por fecha. Si falla, se aplica automaticamente el
# fallback de 3.4 y la transaccion se procesa igual.
#
# Token opcional de apis.net.pe. La API gratuita corta con HTTP 429 tras unas
# pocas peticiones por minuto; con token el limite es mayor. Como los tipos de
# cambio se cachean en la tabla exchange_rates, en la practica no hace falta.
# EXCHANGE_RATE_API_TOKEN=

# Solo si cambias de proveedor de tipo de cambio.
# EXCHANGE_RATE_API_URL=https://api.apis.net.pe/v1/tipo-cambio-sunat

# ---------------------------------------------------------------------------
#  Solo para scripts locales — NO hace falta en Vercel
# ---------------------------------------------------------------------------

# Cadena de conexion a PostgreSQL, usada unicamente por `npm run db:init`
# y `npm run db:check` para crear y verificar el esquema desde la terminal.
# La aplicacion NUNCA la usa: en runtime todo pasa por @supabase/supabase-js.
#
# Supabase -> boton Connect -> pestana "Session pooler" -> copia el URI y
# sustituye [YOUR-PASSWORD] por la contrasena de tu base de datos.
# Usa el Session pooler, no el Transaction pooler (puerto 6543).
# SUPABASE_DB_URL=postgresql://postgres.turef:CONTRASENA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
#  Opcionales — tienen valores por defecto sensatos.
#  Descoméntalas solo si necesitas cambiarlos.
# ---------------------------------------------------------------------------

# Remitentes aceptados por /api/ingest/bcp, separados por coma.
# Por defecto: notificaciones@notificacionesbcp.com.pe
# BCP_ALLOWED_SENDERS=notificaciones@notificacionesbcp.com.pe,otro@bcp.com.pe

# Filtro opcional por asunto (subconjunto, sin distinguir mayúsculas ni tildes).
# Vacío = no se filtra por asunto. Aún no conocemos el asunto exacto de todos
# los correos del BCP, así que el MVP valida por remitente + contenido.
# Rellénalo cuando confirmes el asunto real.
# BCP_SUBJECT_FILTER=
